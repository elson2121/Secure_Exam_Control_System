<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.secs.client.controllers.ExamController" spacing="15"
      style="-fx-padding: 20; -fx-background-color: #f8f9fa;">

    <!-- Header -->
    <HBox spacing="20" alignment="CENTER" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 10;">
        <Label fx:id="lblExamTitle" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
               HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTimer" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Progress -->
    <HBox spacing="15" alignment="CENTER" style="-fx-padding: 10; -fx-background-color: white; -fx-background-radius: 10;">
        <Label fx:id="lblQuestionCount" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        <ProgressBar fx:id="progressBar" HBox.hgrow="ALWAYS" prefWidth="500"/>
        <HBox spacing="10">
            <Label fx:id="lblQuestionType" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
            <Label fx:id="lblPoints" style="-fx-font-size: 14px; -fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
        </HBox>
    </HBox>

    <!-- Question Area -->
    <VBox spacing="20" style="-fx-padding: 25; -fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
        <TextArea fx:id="txtQuestion" editable="false" wrapText="true"
                  style="-fx-font-size: 18px; -fx-font-weight: 500; -fx-background-color: transparent;
                         -fx-border-color: transparent; -fx-text-fill: #2c3e50;"
                  prefHeight="120"/>

        <!-- Options Container -->
        <VBox fx:id="optionsContainer" spacing="15" style="-fx-padding: 10;"/>
    </VBox>

    <!-- Navigation -->
    <HBox spacing="20" alignment="CENTER" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 10;">
        <Button fx:id="btnPrevious" text="← Previous" onAction="#handlePrevious"
                style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-pref-width: 120; -fx-pref-height: 40;
                       -fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 5;"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button fx:id="btnNext" text="Next →" onAction="#handleNext"
                style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-pref-width: 120; -fx-pref-height: 40;
                       -fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 5;"/>

        <Button fx:id="btnSubmit" text="✅ Submit Exam" onAction="#handleSubmit"
                style="-fx-font-size: 16px; -fx-font-weight: bold;
                       -fx-background-color: linear-gradient(to right, #e74c3c, #c0392b); -fx-text-fill: white;
                       -fx-pref-width: 180; -fx-pref-height: 50; -fx-background-radius: 8;"/>
    </HBox>

    <!-- Warning -->
    <HBox alignment="CENTER" style="-fx-padding: 10; -fx-background-color: #fff3cd; -fx-background-radius: 10; -fx-border-color: #ffeaa7; -fx-border-width: 2; -fx-border-radius: 10;">
        <Label text="⚠️ IMPORTANT: Do not close this window or use shortcuts during exam!"
               style="-fx-text-fill: #856404; -fx-font-weight: bold; -fx-font-size: 14px;"/>
    </HBox>
</VBox>
        <!-- Developer Signature -->
<HBox alignment="CENTER" style="-fx-padding: 10 0 0 0;">
<Label text="SECS v1.0 | Developer: Kuei Poch Kuei | Dilla University CS"
       style="-fx-text-fill: #666666; -fx-font-size: 10px; -fx-font-style: italic;"/>
</HBox>